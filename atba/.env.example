# ATBA backend configuration template. Copy to atba/.env and fill in your keys (.env is already
# gitignored, it won't be committed):
#     cp atba/.env.example atba/.env
# atba/__init__.py automatically reads these variables from atba/.env in the same directory at
# import time — the CLI/FastAPI/example scripts don't need to $env:... them manually. Environment
# variables already set manually in the shell take priority over .env's values.

# Login authentication (see atba/auth.py) — a single account, not a multi-user account system, just a
# barrier for the deployed environment, preventing anyone who gets the URL casually shared with them
# from directly calling LLM/retrieval APIs that cost real money. Defaults to atba / atba if unset —
# **production deployments must override both of these**, the default credentials are not a secure
# default.
ATBA_AUTH_USERNAME=atba
ATBA_AUTH_PASSWORD=atba
# The signing key for the login token — defaults to a hardcoded development value in the code if unset
# (likewise insecure). Production deployments must override this with a genuinely random value, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
ATBA_AUTH_SECRET_KEY=

# Fill in at least one provider's key. If more than one are filled in, which one is used is decided by
# ATBA_LLM_PROVIDER below (or the CLI's --provider / the frontend form's Provider selector) — no
# conflict.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# OpenAI is the third supported provider — native OpenAIChatModel/OpenAIProvider, no compatibility shim
# needed (unlike DeepSeek's OpenAI-compatible protocol). Unlike DeepSeek's reasoner, OpenAI's own
# reasoning models (o-series, gpt-5) do support function calling, which every step in this project
# requires, so there's no equivalent "don't use the reasoning model" restriction here.
OPENAI_API_KEY=

# Optional: the default LLM provider, "anthropic", "deepseek", or "openai"; defaults to anthropic if
# unset. Doesn't affect a single call overriding it with --provider.
ATBA_LLM_PROVIDER=deepseek

# Optional: overrides each provider's default model name; defaults to the values in the code if unset
# (anthropic: claude-sonnet-5, deepseek: deepseek-chat, openai: gpt-5). Reasoning models like
# deepseek-reasoner don't support function calling, and every step in this project forces tool calls, so
# make sure whatever DeepSeek model name you put here supports function calling (OpenAI's reasoning
# models don't have this restriction, see above). A single call can still override this with --model.
ATBA_ANTHROPIC_MODEL=
ATBA_DEEPSEEK_MODEL=deepseek-v4-flash
ATBA_OPENAI_MODEL=

# Optional: the directory each run's output files (runs/<run_id>/stepN.json) are stored in; defaults
# to runs/ under the repo root if unset.
ATBA_RUNS_DIR=

# Only needed once frontend and backend are deployed on two different domains (e.g. a frontend at
# theory.example.com calling a backend at theoryapi.example.com) — without this, the browser blocks
# the cross-origin request with a CORS error even though the backend itself is reachable and healthy.
# localhost dev-server ports are already allowed unconditionally, see atba/api.py. Comma-separated for
# more than one frontend origin (e.g. staging + production).
ATBA_FRONTEND_ORIGINS=

# For D.4's retrieval infrastructure: step 3 (atba/step3.py) genuinely issues UTD24-scoped Scopus
# literature retrieval via the search_scopus MCP tool, and needs a real Scopus API key. Apply at
# https://dev.elsevier.com/ — note: a key obtained this way usually only has basic Search API access;
# abstract (Abstract Retrieval API) access typically requires an institutional-tier subscription,
# confirmed by testing: even when retrieval itself works fine, the abstract endpoint may still return
# 401 Unauthorized (see get_abstract_via_scopus_raw's docstring in atba/retrieval.py) — this doesn't
# affect the search query itself, only abstracts, which are instead filled in via the two key-free open
# sources below. Without SCOPUS_API_KEY set, search_scopus errors out explicitly stating this variable
# is missing, rather than failing silently.
SCOPUS_API_KEY=
# Optional: an institutional token — some institutions' Scopus access requires this additionally to
# pass validation (likewise, check with your institution's library).
SCOPUS_INST_TOKEN=

# For paper abstracts: the get_paper_abstract tool looks up Semantic Scholar/OpenAlex by DOI (both
# work without a key; the two below are optional quota upgrades, and things work normally without
# them).
# Optional: a Semantic Scholar API key, free to apply for
# (https://www.semanticscholar.org/product/api), raises the rate limit from the public pool to a
# higher tier; without it, the unauthenticated public rate limit is used, which may slow down
# occasionally under heavier query volume.
SEMANTIC_SCHOLAR_API_KEY=
# Optional: OpenAlex's "polite pool" contact email — including any valid email address upgrades from
# the default rate limit to a more generous tier; officially recommended but not required, see
# https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication.
CONTACT_EMAIL=
